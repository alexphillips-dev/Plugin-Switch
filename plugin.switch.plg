<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name "plugin.switch">
<!ENTITY author "alexphillips-dev">
<!ENTITY version "2026.10.29.11">
<!ENTITY pluginURL "https://raw.githubusercontent.com/alexphillips-dev/Plugin-Switch/dev/plugin.switch.plg">
<!ENTITY md5 "5582d76fa5441762d661ca0dc1fbd216">
<!ENTITY sha256 "782edc165af0369386519ab4618dae89ad4dbbbacc46380926f2be575234078e">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" icon="fa-toggle-on" min="7.0.0" support="https://github.com/alexphillips-dev/Plugin-Switch/issues">
<CHANGES>
### 2026.10.29.11
- Deliver source files in a branch-specific, SHA-256-verified versioned Unraid .txz package, following FolderView Plus.
- Resume the sequential date/patch version scheme and remove the temporary bridge release.
- Add cache-busted update diagnostics and copyable forced-refresh commands for outdated dev installations.
- Validate package checksums, archive contents, branch URLs, release ordering and documentation.
</CHANGES>
<FILE Name="/boot/config/plugins/&name;/&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>https://raw.githubusercontent.com/alexphillips-dev/Plugin-Switch/dev/archive/&name;-&version;.txz</URL>
<MD5>&md5;</MD5>
<SHA256>&sha256;</SHA256>
</FILE>
<FILE Run="/bin/bash"><INLINE><![CDATA[
set -eu
mkdir -p /boot/config/plugins/plugin.switch/adapters /boot/config/plugins/plugin.switch/disabled
chmod 0700 /boot/config/plugins/plugin.switch/adapters /boot/config/plugins/plugin.switch/disabled
]]></INLINE></FILE>
<FILE Run="/bin/bash" Method="remove"><INLINE><![CDATA[
rm -rf /usr/local/emhttp/plugins/plugin.switch
]]></INLINE></FILE>
</PLUGIN>
