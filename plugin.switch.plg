<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name "plugin.switch">
<!ENTITY author "Alex Phillips">
<!ENTITY version "2026.10.29-dev1">
<!ENTITY pluginURL "https://raw.githubusercontent.com/alexphillips-dev/Plugin-Switch/dev/plugin.switch.plg">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" icon="fa-toggle-on" min="7.0.0">
<CHANGES>2026.10.29-dev1 - Initial development release: safe per-plugin runtime toggles.</CHANGES>
<FILE Name="/usr/local/emhttp/plugins/&name;/Controller.php"><INLINE><![CDATA[<?php
declare(strict_types=1);

/**
 * Plugin Switch runtime controller.
 *
 * A .plg defines an installation, NOT a universally stoppable service.
 * We only change a live plugin when a trusted, plugin-specific adapter exists.
 */
final class PluginSwitchController
{
    private string $boot;
    private string $park;
    private string $installed;
    private string $adapters;
    private string $run;
    private string $pluginCommand;

    public function __construct(
        string $boot = '/boot/config/plugins',
        string $installed = '/var/log/plugins',
        string $run = '/run/plugin-switch',
        string $pluginCommand = '/usr/local/sbin/plugin'
    ) {
        $this->boot = rtrim($boot, '/');
        $this->park = $this->boot . '/plugin.switch/disabled';
        $this->adapters = $this->boot . '/plugin.switch/adapters';
        $this->installed = rtrim($installed, '/');
        $this->run = rtrim($run, '/');
        $this->pluginCommand = $pluginCommand;
    }

    private function validId(string $id): bool
    {
        return strlen($id) <= 128
            && preg_match('/^[a-zA-Z0-9][a-zA-Z0-9._-]*\\.plg$/D', $id) === 1
            && $id !== 'plugin.switch.plg'
            && $id !== 'unRAIDServer.plg';
    }

    private function pluginPaths(string $id): array
    {
        if (!$this->validId($id)) {
            throw new RuntimeException('Invalid or protected plugin.');
        }
        return [
            $this->boot . '/' . $id,
            $this->park . '/' . $id,
            $this->installed . '/' . $id,
            $this->run . '/' . $id
        ];
    }

    private function adapter(string $id): ?string
    {
        $name = substr($id, 0, -4);
        $file = $this->adapters . '/' . $name . '.sh';
        if (!is_file($file) || is_link($file) || filesize($file) > 65536) {
            return null;
        }
        $mode = fileperms($file);
        if ($mode === false || ($mode & 0022) !== 0) {
            return null;
        }
        // On Unraid, adapters must be installed by root, not uploaded by the browser.
        if (fileowner($file) !== 0) {
            return null;
        }
        return $file;
    }

    private function execute(array $args, int $timeout = 15): array
    {
        $command = array_merge(['/usr/bin/timeout', '--kill-after=2s', $timeout . 's'], $args);
        $proc = @proc_open($command, [
            0 => ['pipe', 'r'],
            1 => ['pipe', 'w'],
            2 => ['pipe', 'w']
        ], $pipes, null, ['PATH' => '/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin']);
        if (!is_resource($proc)) {
            throw new RuntimeException('Failed to launch runtime controller.');
        }
        fclose($pipes[0]);
        $stdout = stream_get_contents($pipes[1], 8192);
        $stderr = stream_get_contents($pipes[2], 8192);
        fclose($pipes[1]);
        fclose($pipes[2]);
        $code = proc_close($proc);
        return [$code, trim((string)$stdout), trim((string)$stderr)];
    }

    private function state(string $script): string
    {
        [$code, $stdout] = $this->execute(['/bin/bash', $script, 'status'], 8);
        if ($code !== 0 || !in_array($stdout, ['enabled', 'disabled'], true)) {
            throw new RuntimeException('Adapter status must return enabled or disabled (exit 0).');
        }
        return $stdout;
    }

    private function action(string $script, string $verb): void
    {
        [$code, , $stderr] = $this->execute(['/bin/bash', $script, $verb]);
        if ($code !== 0) {
            throw new RuntimeException('Adapter ' . $verb . ' failed (exit ' . $code . '): ' . substr($stderr, 0, 200));
        }
        $wanted = $verb === 'start' ? 'enabled' : 'disabled';
        if ($this->state($script) !== $wanted) {
            throw new RuntimeException('Adapter did not confirm ' . $wanted . ' after ' . $verb . '.');
        }
    }

    private function details(string $id, string $plg, bool $enabled): array
    {
        $name = substr($id, 0, -4);
        $author = '';
        $version = '';
        if (is_file($plg)) {
            // Internal DTD entities are common in Unraid manifests; no network access.
            $old = libxml_use_internal_errors(true);
            $xml = simplexml_load_file($plg, 'SimpleXMLElement', LIBXML_NONET | LIBXML_NOCDATA);
            libxml_clear_errors();
            libxml_use_internal_errors($old);
            if ($xml !== false) {
                $name = (string)($xml['name'] ?? $name);
                $author = (string)($xml['author'] ?? '');
                $version = (string)($xml['version'] ?? '');
            }
        }
        $script = $this->adapter($id);
        $reason = $script ? '' : 'No trusted live-control adapter is installed for this plugin.';
        $runtime = 'unknown';
        if ($script) {
            try {
                $runtime = $this->state($script);
            } catch (Throwable $e) {
                $reason = $e->getMessage();
            }
        }
        return [
            'id' => $id,
            'name' => $name,
            'author' => $author,
            'version' => $version,
            'enabled' => $enabled,
            'runtime' => $runtime,
            'supported' => $script !== null && $runtime !== 'unknown',
            'reason' => $reason,
        ];
    }

    public function all(): array
    {
        $items = [];
        foreach (glob($this->installed . '/*.plg') ?: [] as $link) {
            if (!is_link($link)) {
                continue;
            }
            $id = basename($link);
            if (!$this->validId($id)) {
                continue;
            }
            $bootFile = $this->boot . '/' . $id;
            // Only manage regular user plugin definitions on the boot flash.
            if (!is_file($bootFile) || is_link($bootFile) || realpath($link) !== realpath($bootFile)) {
                continue;
            }
            $items[$id] = $this->details($id, $bootFile, true);
        }
        foreach (glob($this->park . '/*.plg') ?: [] as $file) {
            $id = basename($file);
            if (!$this->validId($id) || is_link($file) || isset($items[$id])) {
                continue;
            }
            $items[$id] = $this->details($id, $file, false);
        }
        ksort($items, SORT_NATURAL | SORT_FLAG_CASE);
        return array_values($items);
    }

    public function change(string $id, bool $enable): array
    {
        [$active, $disabled, $link, $marker] = $this->pluginPaths($id);
        if (!is_dir($this->run) && !mkdir($this->run, 0700, true) && !is_dir($this->run)) {
            throw new RuntimeException('Cannot create runtime lock directory.');
        }
        $lock = fopen($this->run . '/controller.lock', 'c');
        if ($lock === false || !flock($lock, LOCK_EX)) {
            throw new RuntimeException('Could not lock plugin operations.');
        }
        try {
            $script = $this->adapter($id);
            if ($script === null) {
                throw new RuntimeException('Live control requires a trusted plugin-specific adapter.');
            }
            if ($enable) {
                if (!is_file($disabled) || is_link($disabled) || file_exists($active)) {
                    throw new RuntimeException('Plugin is not safely parked, or an active file conflicts.');
                }
                if (is_link($link) || file_exists($link)) {
                    throw new RuntimeException('An installed plugin entry conflicts with the parked plugin.');
                }
                if (is_file($marker)) {
                    // Stopped during this boot: restore without reinstalling.
                    if (!rename($disabled, $active)) {
                        throw new RuntimeException('Could not restore plugin manifest.');
                    }
                    if (!symlink($active, $link)) {
                        rename($active, $disabled);
                        throw new RuntimeException('Could not restore installed plugin registration.');
                    }
                    try {
                        if ($this->state($script) !== 'enabled') {
                            $this->action($script, 'start');
                        }
                    } catch (Throwable $e) {
                        @unlink($link);
                        @rename($active, $disabled);
                        throw $e;
                    }
                    @unlink($marker);
                } else {
                    // A reboot has removed the plugin's installed files.
                    // Use the official install lifecycle, then verify the adapter.
                    [$code, , $stderr] = $this->execute([$this->pluginCommand, 'install', $disabled], 120);
                    if ($code !== 0 || !is_file($active) || !is_link($link)) {
                        throw new RuntimeException('Unraid could not reinstall the parked plugin. ' . substr($stderr, 0, 200));
                    }
                    if ($this->state($script) !== 'enabled') {
                        $this->action($script, 'start');
                    }
                    if (!unlink($disabled)) {
                        throw new RuntimeException('Plugin started, but its parked manifest could not be removed.');
                    }
                }
            } else {
                if (!is_file($active) || is_link($active) || is_file($disabled)) {
                    throw new RuntimeException('Plugin is not safely installed, or a parked file conflicts.');
                }
                if (!is_link($link) || realpath($link) !== realpath($active)) {
                    throw new RuntimeException('Plugin registration is inconsistent; refusing to disable.');
                }
                if (!is_dir($this->park) && !mkdir($this->park, 0700, true) && !is_dir($this->park)) {
                    throw new RuntimeException('Cannot create disabled-plugin directory.');
                }
                if ($this->state($script) !== 'disabled') {
                    $this->action($script, 'stop');
                }
                if (!rename($active, $disabled)) {
                    // Do not report success if persistence failed.
                    $this->action($script, 'start');
                    throw new RuntimeException('Could not park the plugin manifest.');
                }
                if (!unlink($link)) {
                    @rename($disabled, $active);
                    $this->action($script, 'start');
                    throw new RuntimeException('Could not unregister the stopped plugin.');
                }
                file_put_contents($marker, 'stopped this boot', LOCK_EX);
            }
            error_log('[plugin.switch] ' . ($enable ? 'enabled ' : 'disabled ') . $id);
            $file = $enable ? $active : $disabled;
            return $this->details($id, $file, $enable);
        } finally {
            flock($lock, LOCK_UN);
            fclose($lock);
        }
    }
}
]]></INLINE></FILE>
<FILE Name="/usr/local/emhttp/plugins/&name;/api.php"><INLINE><![CDATA[<?php
declare(strict_types=1);
header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');
header('X-Content-Type-Options: nosniff');
require_once __DIR__ . '/Controller.php';
function respond(int $status, array $payload): never {
    http_response_code($status);
    echo json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE);
    exit;
}
try {
    $manager = new PluginSwitchController();
    if ($_SERVER['REQUEST_METHOD'] === 'GET') {
        respond(200, ['plugins' => $manager->all()]);
    }
    if ($_SERVER['REQUEST_METHOD'] !== 'POST') respond(405, ['error' => 'Method not allowed']);
    // Unraid validates POST csrf_token in its local_prepend.php. Independently
    // validate it here, too, so alternative hosting cannot bypass the guard.
    $session = @parse_ini_file('/var/local/emhttp/var.ini', false, INI_SCANNER_RAW);
    $expected = $session['csrf_token'] ?? null;
    $received = $_POST['csrf_token'] ?? null;
    if (!is_string($expected) || $expected === '' ||
        !is_string($received) || !hash_equals($expected, $received)) {
        respond(403, ['error' => 'Invalid CSRF token']);
    }
    $id = $_POST['id'] ?? null;
    $target = $_POST['enabled'] ?? null;
    if (!is_string($id) || !in_array($target, ['0','1'], true)) {
        respond(400, ['error' => 'Invalid plugin or requested state']);
    }
    respond(200, ['plugin' => $manager->change($id, $target === '1')]);
} catch (Throwable $e) {
    respond(409, ['error' => $e->getMessage()]);
}
]]></INLINE></FILE>
<FILE Name="/usr/local/emhttp/plugins/&name;/switch.js"><INLINE><![CDATA[(function () {
  'use strict';
  const api = '/plugins/plugin.switch/api.php';
  const cache = new Map();
  let loading = false;
  let lastFetch = 0;
  const escapeHtml = s => String(s).replace(/[&<>"']/g, c => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  })[c]);
  function isPlugins() {
    return !!document.querySelector('#plugin_table thead');
  }
  function table() {
    return document.getElementById('plugin_table');
  }
  function activeRowMap() {
    const map = new Map();
    document.querySelectorAll('#plugin_table tbody tr').forEach(row => {
      const entry = row.querySelector('input.remove[data]');
      if (entry) map.set(entry.getAttribute('data'), row);
    });
    return map;
  }
  function getStatus(p) {
    if (!p.supported) return 'No live adapter';
    return p.runtime === 'enabled' ? 'Running' : p.runtime === 'disabled' ? 'Stopped' : 'Unknown';
  }
  function makeCell(p) {
    const label = p.enabled ? 'Disable' : 'Enable';
    const disabled = !p.supported;
    const reason = disabled ? p.reason : label + ' ' + p.name;
    const checked = p.runtime === 'enabled' ? ' checked' : '';
    return '<td class="ps-cell" data-plugin-switch="' + escapeHtml(p.id) + '">' +
      '<label class="ps-control" title="' + escapeHtml(reason) + '">' +
      '<input type="checkbox" class="ps-toggle" aria-label="' + escapeHtml(label + ' ' + p.name) +
      '" data-id="' + escapeHtml(p.id) + '"' + checked + (disabled ? ' disabled' : '') + '>' +
      '<span class="ps-track"></span></label>' +
      '<small class="ps-state">' + escapeHtml(getStatus(p)) + '</small></td>';
  }
  function addHeader(t) {
    const header = t.querySelector('thead tr');
    if (!header || header.querySelector('.ps-head')) return;
    const th = document.createElement('th');
    th.className = 'ps-head';
    th.textContent = 'Enabled';
    // Append as final column so native tablesorter column mappings remain stable.
    header.appendChild(th);
  }
  function addCSS() {
    if (document.getElementById('ps-css')) return;
    const style = document.createElement('style');
    style.id = 'ps-css';
    style.textContent = '.ps-head,.ps-cell{text-align:center!important;min-width:90px}' +
      '.ps-control{position:relative;display:inline-flex;vertical-align:middle;cursor:pointer}' +
      '.ps-toggle{position:absolute;opacity:0;width:42px;height:24px;cursor:pointer}' +
      '.ps-track{width:42px;height:24px;border-radius:16px;background:#777;position:relative;pointer-events:none;transition:background .15s}' +
      '.ps-track:after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:100%;background:#fff;transition:transform .15s}' +
      '.ps-toggle:checked+.ps-track{background:#278d63}' +
      '.ps-toggle:checked+.ps-track:after{transform:translateX(18px)}' +
      '.ps-toggle:focus-visible+.ps-track{outline:2px solid #378aff;outline-offset:2px}' +
      '.ps-toggle:disabled+.ps-track{opacity:.33;cursor:not-allowed}' +
      '.ps-state{display:block;white-space:nowrap;margin-top:3px;font-size:10px}' +
      '.ps-note{color:inherit;opacity:.8;font-size:12px}' +
      '.ps-disabled-row td{opacity:.8}' +
      '.ps-disabled-row td.ps-cell{opacity:1}';
    document.head.appendChild(style);
  }
  function ensureTable() {
    const t = table();
    if (!t) return;
    addCSS();
    addHeader(t);
    const rows = activeRowMap();
    // Remove stale/incomplete cells after Unraid refreshes its table.
    rows.forEach((row,id) => {
      const p = cache.get(id);
      if (!p) return;
      const existing = row.querySelector('td.ps-cell');
      if (!existing) row.insertAdjacentHTML('beforeend', makeCell(p));
    });
    // Disabled entries are not returned by ShowPlugins.php. Inject them into
    // the same table with clear metadata and an inert uninstall column.
    cache.forEach(p => {
      if (p.enabled || rows.has(p.id)) return;
      const key = 'ps-disabled-' + p.id.replace(/[^a-z0-9_-]/gi, '_');
      if (document.getElementById(key)) return;
      const row = document.createElement('tr');
      row.id = key;
      row.className = 'ps-disabled-row';
      row.innerHTML = '<td>◌</td><td><strong>' + escapeHtml(p.name) +
        '</strong><br><span class="ps-note">Disabled by Plugin Switch</span></td>' +
        '<td>' + escapeHtml(p.author) + '</td><td>' + escapeHtml(p.version) +
        '</td><td>Disabled</td><td>—</td>' + makeCell(p);
      t.tBodies[0]?.appendChild(row);
    });
    t.querySelectorAll('tr.ps-disabled-row').forEach(row => {
      const id = row.querySelector('input.ps-toggle')?.dataset.id;
      if (!id || cache.get(id)?.enabled) row.remove();
    });
    t.querySelectorAll('td.ps-cell').forEach(cell => {
      const p = cache.get(cell.dataset.pluginSwitch);
      if (!p) return;
      const toggle = cell.querySelector('input.ps-toggle');
      if (document.activeElement === toggle || toggle?.dataset.busy) return;
      if (toggle) {
        toggle.checked = p.runtime === 'enabled';
        toggle.disabled = !p.supported;
      }
      const status = cell.querySelector('.ps-state');
      if (status) status.textContent = getStatus(p);
    });
    // Fixed-width placeholders and tablesorter may need adjustment after a new column.
    t.querySelectorAll('tbody td[colspan="6"]').forEach(td => td.colSpan = 7);
  }
  function csrf() {
    if (typeof window.csrf_token === 'string') return window.csrf_token;
    return '';
  }
  async function refresh() {
    if (loading || !isPlugins()) return;
    loading = true;
    try {
      const response = await fetch(api, {credentials:'same-origin',cache:'no-store'});
      if (!response.ok) throw new Error('Cannot load plugin states');
      const data = await response.json();
      cache.clear();
      (data.plugins || []).forEach(p => cache.set(p.id,p));
      ensureTable();
      lastFetch = Date.now();
    } catch (e) {
      console.warn('[Plugin Switch]',e);
    } finally {
      loading = false;
    }
  }
  async function toggle(input) {
    const id = input.dataset.id;
    const p = cache.get(id);
    if (!p || !p.supported) return;
    const enable = input.checked;
    const verb = enable ? 'enable' : 'disable';
    if (!window.confirm('Really ' + verb + ' ' + p.name + '? Its services and interfaces may be affected immediately.')) {
      input.checked = !enable; return;
    }
    input.dataset.busy = '1';
    input.disabled = true;
    try {
      const form = new URLSearchParams({id:id,enabled:enable ? '1':'0',csrf_token:csrf()});
      const response = await fetch(api, {
        method:'POST',credentials:'same-origin',
        headers:{'Content-Type':'application/x-www-form-urlencoded'},
        body:form
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'Plugin state change failed');
      cache.set(id, data.plugin);
      // Unraid's own list will now be stale: request a reload after state update.
      window.location.reload();
    } catch (e) {
      input.checked = !enable;
      window.alert('Plugin Switch: ' + e.message);
      delete input.dataset.busy;
      input.disabled = !p.supported;
      await refresh();
    }
  }
  document.addEventListener('change', e => {
    if (e.target.matches('.ps-toggle')) toggle(e.target);
  });
  // MutationObserver handles async ShowPlugins.php list rendering.
  let queued = false;
  const observer = new MutationObserver(() => {
    if (queued || !isPlugins()) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      ensureTable();
      if (Date.now() - lastFetch > 30000) refresh();
    });
  });
  function init() {
    observer.observe(document.body, {childList:true,subtree:true});
    if (isPlugins()) refresh();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded',init);
  else init();
})();
]]></INLINE></FILE>
<FILE Name="/usr/local/emhttp/plugins/&name;/PluginSwitch_Loader.page"><INLINE><![CDATA[Menu="Buttons:105"
Link="nav-user"
---
<?php
// This page is rendered by the Unraid WebGUI on each page with nav-user.
// The script is isolated and only touches the installed Plugins table.
?>
<script src="/plugins/plugin.switch/switch.js?v=20261029" defer></script>
]]></INLINE></FILE>
<FILE Run="/bin/bash"><INLINE><![CDATA[
set -eu
mkdir -p /boot/config/plugins/plugin.switch/adapters
mkdir -p /boot/config/plugins/plugin.switch/disabled
mkdir -p /usr/local/emhttp/plugins/plugin.switch
chmod 0700 /boot/config/plugins/plugin.switch/adapters /boot/config/plugins/plugin.switch/disabled
]]></INLINE></FILE>
<FILE Run="/bin/bash" Method="remove"><INLINE><![CDATA[
# Do not delete persisted adapters or disabled plugin definitions.
rm -rf /usr/local/emhttp/plugins/plugin.switch
]]></INLINE></FILE>
</PLUGIN>
